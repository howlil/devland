{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Devland Resolved Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "state",
    "policies",
    "profiles",
    "execution",
    "workflow"
  ],
  "properties": {
    "schema": {
      "const": "devland.context/v1"
    },
    "project": {
      "allOf": [
        { "$ref": "#/$defs/reference" },
        {
          "type": "object",
          "required": ["content"],
          "properties": {
            "content": { "type": "object" }
          }
        }
      ]
    },
    "state": {
      "allOf": [
        { "$ref": "#/$defs/reference" },
        {
          "type": "object",
          "properties": {
            "content": { "type": "object" }
          }
        }
      ]
    },
    "policies": {
      "type": "array",
      "items": { "$ref": "#/$defs/guidanceEntry" }
    },
    "profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/guidanceEntry" }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "signals", "budget"],
      "properties": {
        "lane": {
          "enum": ["rapid", "guided", "deliberate"]
        },
        "signals": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["analysis", "context", "verification"],
          "properties": {
            "analysis": { "type": "string" },
            "context": { "type": "string" },
            "verification": { "type": "string" }
          }
        }
      }
    },
    "workflow": {
      "allOf": [
        { "$ref": "#/$defs/reference" },
        {
          "type": "object",
          "required": ["id", "content"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "content": { "type": "string" }
          }
        }
      ]
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "guidanceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "content": { "type": "string" }
      }
    }
  }
}
