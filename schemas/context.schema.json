{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Devland Resolved Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "state",
    "policies",
    "profiles",
    "execution",
    "workflow"
  ],
  "properties": {
    "schema": {
      "const": "devland.context/v1"
    },
    "project": {
      "allOf": [
        { "$ref": "#/$defs/reference" },
        {
          "type": "object",
          "required": ["content"],
          "properties": {
            "content": { "type": "object" }
          }
        }
      ]
    },
    "state": {
      "allOf": [
        { "$ref": "#/$defs/reference" },
        {
          "type": "object",
          "properties": {
            "content": { "type": "object" }
          }
        }
      ]
    },
    "work": { "$ref": "#/$defs/work" },
    "verification": { "$ref": "#/$defs/verification" },
    "policies": {
      "type": "array",
      "items": { "$ref": "#/$defs/guidanceEntry" }
    },
    "profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/guidanceEntry" }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "signals", "budget"],
      "properties": {
        "lane": {
          "enum": ["rapid", "guided", "deliberate"]
        },
        "signals": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["analysis", "context", "verification"],
          "properties": {
            "analysis": { "type": "string" },
            "context": { "type": "string" },
            "verification": { "type": "string" }
          }
        }
      }
    },
    "workflow": {
      "allOf": [
        { "$ref": "#/$defs/reference" },
        {
          "type": "object",
          "required": ["id", "content"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "content": { "type": "string" }
          }
        }
      ]
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "guidanceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "content": { "type": "string" }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "intent", "acceptance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "intent": { "type": "string", "minLength": 1 },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "excluded": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "expected_outcome": { "type": "string", "minLength": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criticality", "failure_modes", "boundary", "cost", "diagnostics"],
      "properties": {
        "criticality": {
          "enum": ["critical", "behavioral", "peripheral"]
        },
        "failure_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "boundary": {
          "enum": ["static", "function", "component", "integration", "contract", "process", "journey", "release"]
        },
        "cost": {
          "enum": ["cheap", "moderate", "expensive"]
        },
        "reason": { "type": "string", "minLength": 1 },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/verificationDiagnostic" }
        }
      }
    },
    "verificationDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "const": "warning" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
