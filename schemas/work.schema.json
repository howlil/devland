{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Devland Transient Work Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "intent", "acceptance"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "minLength": 1 },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "excluded": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "expected_outcome": { "type": "string", "minLength": 1 }
  }
}
